# ==============================================================================
# MARKETING OS v2.1 -- PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application Settings
APP_NAME="Marketing OS Enterprise API"
ENVIRONMENT="production"
DEBUG=False
MIN_QUALITY_SCORE=85

# Allowed CORS Origins (STRICT: Must use HTTPS, No Wildcards, No Localhost)
ALLOWED_ORIGINS=["https://app.yourdomain.com"]

# Database & Storage (Supabase / Managed PostgreSQL)
DATABASE_URL="postgresql://postgres:your_strong_db_password@db.your-project.supabase.co:5432/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-admin-key"

# Media Storage Subsystem (S3 / Supabase Public Bucket)
MEDIA_STORAGE_TYPE="local"
MEDIA_PUBLIC_BASE_URL="https://api.yourdomain.com"
MAX_MEDIA_FILE_SIZE=52428800

# High-Entropy Cryptographic Keys (Auto-enforced minimum 256 bits by config validator)
ACTIVE_KEY_VERSION="v2"
TOKEN_ENCRYPTION_KEY="replace_with_generated_32byte_aes_gcm_key"
JWT_SECRET="replace_with_generated_32byte_jwt_signing_key"

# Distributed Cache & Background Worker Broker
REDIS_URL="redis://default:your_redis_password@redis-server:6379/0"

# Social Provider Mode: 'live' is mandatory for production (mock is strictly blocked by validator)
SOCIAL_PROVIDER_MODE="live"

# LinkedIn Developer App Credentials
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="https://api.yourdomain.com/v1/social-auth/linkedin/callback"

# X (Twitter) Developer Portal Credentials
X_CLIENT_ID="your_x_client_id"
X_CLIENT_SECRET="your_x_client_secret"
X_REDIRECT_URI="https://api.yourdomain.com/v1/social-auth/x/callback"
X_BEARER_TOKEN="your_x_bearer_token"

# Meta / Instagram Graph API App Credentials
INSTAGRAM_APP_ID="your_instagram_app_id"
INSTAGRAM_APP_SECRET="your_instagram_app_secret"
INSTAGRAM_REDIRECT_URI="https://api.yourdomain.com/v1/social-auth/instagram/callback"
META_ACCESS_TOKEN="your_meta_system_access_token"

# Google Cloud / YouTube Data API Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
YOUTUBE_REDIRECT_URI="https://api.yourdomain.com/v1/social-auth/youtube/callback"

# LLM Inference Providers
OPENAI_API_KEY=""
NVIDIA_NIM_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
